@using Data.Model
@using Data.Model.Data
@using Microsoft.AspNetCore.Identity
@inject SignInManager<AppUser> SignInManager
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var isAdmin = User.IsInRole(Constants.AppRoles.ADMIN);
    var isSignedIn = SignInManager.IsSignedIn(User);
    // Every page reachable from the floating sidebar lives under /Dashboard/ - the sidebar itself
    // only makes sense once the user is there, so it's gated on the same prefix.
    var isDashboard = Context.Request.Path.StartsWithSegments("/Dashboard");
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Web</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Web.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div id="particles-background"></div>
    <div class="app-shell">
        @if (isDashboard)
        {
            <nav class="app-sidebar" aria-label="Primary">
                <ul class="app-sidebar-nav">
                    <li class="app-sidebar-home">
                        <a class="app-sidebar-link @(currentController == "Home" && currentAction == "Index" ? "active" : "")"
                           asp-controller="Home" asp-action="Index" title="Home">
                            <i class="fa-solid fa-house"></i>
                        </a>
                    </li>
                    <li>
                        <a class="app-sidebar-link @(currentController == "Dashboard" ? "active" : "")"
                           asp-controller="Dashboard" asp-action="Index" title="Dashboard">
                            <i class="fa-solid fa-gauge"></i>
                        </a>
                    </li>
                    <li>
                        <a class="app-sidebar-link @(currentController == "Transactions" ? "active" : "")"
                           asp-controller="Transactions" asp-action="Accounts" title="Accounts">
                            <i class="fa-solid fa-credit-card"></i>
                        </a>
                    </li>
                                    <li>
                        <a class="app-sidebar-link @(currentController == "Statistics" ? "active" : "")"
                           asp-controller="Statistics" asp-action="Index" title="Statistics">
                            <i class="fa-solid fa-chart-bar"></i>
                        </a>
                    </li>
                    <li>
                        <a class="app-sidebar-link @(currentController == "Calendar" ? "active" : "")"
                           asp-controller="Calendar" asp-action="Index" title="Calendar">
                            <i class="fa-solid fa-calendar"></i>
                        </a>
                    </li>
                    <li>
                        <a class="app-sidebar-link @(currentController == "Home" && currentAction == "Privacy" ? "active" : "")"
                           asp-controller="Home" asp-action="Privacy" title="Privacy">
                            <i class="fa-solid fa-user-shield"></i>
                        </a>
                    </li>
                    @if (isAdmin)
                    {
                        <li class="app-sidebar-admin">
                            <a class="app-sidebar-link @(currentController == "Admin" ? "active" : "")"
                               asp-controller="Admin" asp-action="Index" title="Admin">
                                <i class="fa-solid fa-shield-halved"></i>
                            </a>
                        </li>
                    }
                </ul>
            </nav>
        }

        <div class="app-content">
            <header class="app-topbar">
                <div class="app-topbar-left">
                    @if (isDashboard)
                    {
                        <a asp-controller="Dashboard" asp-action="Index" title="Insightify">
                            <img src="~/images/logo.svg" alt="Insightify" class="app-topbar-logo" />
                        </a>
                    }
                    else if (isSignedIn)
                    {
                        <a class="btn-pill btn-pill-outline app-topbar-cta" asp-controller="Dashboard" asp-action="Index">
                            <i class="fa-solid fa-gauge"></i>
                            Dashboard
                        </a>
                    }
                </div>

                <div class="app-topbar-right">
                    <div class="app-profile dropdown">
                        @if (isAdmin)
                        {
                            <span class="app-admin-badge">Admin</span>
                        }
                        <button class="app-profile-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="Account">
                            <i class="fa-solid fa-user"></i>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end app-profile-menu">
                            <partial name="_LoginPartial" />
                        </ul>
                    </div>
                </div>
            </header>

            <main class="app-main" role="main">
                @RenderBody()
            </main>
        </div>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Web
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/particles.js/particles.min.js"></script>
    <script src="~/js/particles-background.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
