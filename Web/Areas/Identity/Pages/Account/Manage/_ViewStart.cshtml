@{
    // The default Identity UI (Microsoft.AspNetCore.Identity.UI) ships its own compiled
    // _ViewStart.cshtml for this Account/Manage folder that points at its own bare-bones
    // _Layout.cshtml (no Styles section). This physical file overrides that compiled one so
    // Manage pages use the app's real layout, matching every other Identity page.
    Layout = "/Views/Shared/_Layout.cshtml";
}
