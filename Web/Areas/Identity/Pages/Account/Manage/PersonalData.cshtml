@page
@model PersonalDataModel
@{
    ViewData["Title"] = "Personal Data";
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
}

@section Styles {
    <link rel="stylesheet" href="~/css/manage.css" asp-append-version="true" />
}

<h1 class="page-title">Manage account</h1>

<div class="manage-layout">
    <nav class="manage-nav" aria-label="Manage account">
        <partial name="_ManageNav" />
    </nav>
    <div class="manage-content">
        <div class="manage-card">
            <h3 class="manage-card-title">@ViewData["Title"]</h3>
            <p class="manage-copy">Your account contains personal data that you have given us. This page allows you to download or delete that data.</p>
            <div class="manage-danger-note">
                <strong>Deleting this data will permanently remove your account, and this cannot be recovered.</strong>
            </div>
            <div class="manage-actions">
                <form id="download-data" asp-page="DownloadPersonalData" method="post">
                    <button class="btn-pill btn-pill-outline" type="submit">Download</button>
                </form>
                <a id="delete" asp-page="DeletePersonalData" class="btn-pill btn-pill-danger">Delete</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
