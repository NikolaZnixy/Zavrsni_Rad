@page
@model IndexModel
@{
    ViewData["Title"] = "Profile";
    ViewData["ActivePage"] = ManageNavPages.Index;
}

@section Styles {
    <link rel="stylesheet" href="~/css/manage.css" asp-append-version="true" />
}

<h1 class="page-title">Manage account</h1>

<div class="manage-layout">
    <nav class="manage-nav" aria-label="Manage account">
        <partial name="_ManageNav" />
    </nav>
    <div class="manage-content">
        <div class="manage-card">
            <h3 class="manage-card-title">@ViewData["Title"]</h3>
            <partial name="_StatusMessage" for="StatusMessage" />
            <form id="profile-form" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                <div class="manage-field">
                    <label asp-for="Username"></label>
                    <input asp-for="Username" class="login-input" placeholder="Please choose your username." disabled />
                </div>
                <div class="manage-field">
                    <label asp-for="Input.PhoneNumber"></label>
                    <input asp-for="Input.PhoneNumber" class="login-input" placeholder="Please enter your phone number." />
                    <span asp-validation-for="Input.PhoneNumber" class="text-danger"></span>
                </div>
                <button id="update-profile-button" type="submit" class="btn-pill btn-pill-primary manage-submit-btn">Save</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
