@page
@model EmailModel
@{
    ViewData["Title"] = "Manage Email";
    ViewData["ActivePage"] = ManageNavPages.Email;
}

@section Styles {
    <link rel="stylesheet" href="~/css/manage.css" asp-append-version="true" />
}

<h1 class="page-title">Manage account</h1>

<div class="manage-layout">
    <nav class="manage-nav" aria-label="Manage account">
        <partial name="_ManageNav" />
    </nav>
    <div class="manage-content">
        <div class="manage-card">
            <h3 class="manage-card-title">@ViewData["Title"]</h3>
            <partial name="_StatusMessage" for="StatusMessage" />
            <form id="email-form" method="post">
                <div asp-validation-summary="All" class="text-danger" role="alert"></div>
                @if (Model.IsEmailConfirmed)
                {
                    <div class="manage-field manage-field-verified">
                        <input asp-for="Email" class="login-input" placeholder="Please enter your email." disabled />
                        <span class="manage-verified-badge" title="Email confirmed">&#10003;</span>
                    </div>
                }
                else
                {
                    <div class="manage-field">
                        <label asp-for="Email"></label>
                        <input asp-for="Email" class="login-input" placeholder="Please enter your email." disabled />
                        <button id="email-verification" type="submit" asp-page-handler="SendVerificationEmail" class="manage-link-btn">Send verification email</button>
                    </div>
                }
                <div class="manage-field">
                    <label asp-for="Input.NewEmail"></label>
                    <input asp-for="Input.NewEmail" class="login-input" autocomplete="email" aria-required="true" placeholder="Please enter new email." />
                    <span asp-validation-for="Input.NewEmail" class="text-danger"></span>
                </div>
                <button id="change-email-button" type="submit" asp-page-handler="ChangeEmail" class="btn-pill btn-pill-primary manage-submit-btn">Change email</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
