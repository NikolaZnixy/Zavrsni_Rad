@page
@model LoginModel

@{
    ViewData["Title"] = "Log in";
}

@section Styles {
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
}

<div class="login-hero">
    <div class="login-card">
        <h2 class="login-card-title">Welcome back</h2>
        <p class="login-card-subtitle">Choose how to proceed</p>

        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

        @{
            var googleLogin = Model.ExternalLogins?.FirstOrDefault(p => p.Name == "Google");
        }
        @if (googleLogin is not null)
        {
            <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                <button type="submit" class="login-google-btn" name="provider" value="@googleLogin.Name" title="Log in using your Google account">
                    <svg class="login-google-icon" viewBox="0 0 18 18" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                        <path fill="#4285F4" d="M17.64 9.2c0-.64-.06-1.25-.16-1.84H9v3.48h4.84a4.14 4.14 0 0 1-1.8 2.72v2.26h2.9c1.7-1.57 2.7-3.88 2.7-6.62z" />
                        <path fill="#34A853" d="M9 18c2.43 0 4.47-.8 5.96-2.18l-2.9-2.26c-.8.54-1.83.86-3.06.86-2.35 0-4.34-1.59-5.05-3.72H.9v2.33A9 9 0 0 0 9 18z" />
                        <path fill="#FBBC05" d="M3.95 10.7A5.4 5.4 0 0 1 3.68 9c0-.59.1-1.17.27-1.7V4.97H.9A9 9 0 0 0 0 9c0 1.45.35 2.83.9 4.03z" />
                        <path fill="#EA4335" d="M9 3.58c1.32 0 2.5.46 3.44 1.35l2.58-2.58C13.46.89 11.43 0 9 0A9 9 0 0 0 .9 4.97L3.95 7.3C4.66 5.17 6.65 3.58 9 3.58z" />
                    </svg>
                    Continue with Google
                </button>
            </form>

            <div class="login-divider">or</div>
        }

        <form id="account" method="post">
            <div class="login-field">
                <label asp-for="Input.Email">Email</label>
                <input asp-for="Input.Email" class="login-input" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>
            <div class="login-field">
                <label asp-for="Input.Password">Password</label>
                <input asp-for="Input.Password" class="login-input" autocomplete="current-password" aria-required="true" placeholder="Enter your password" />
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>
            <div class="login-checkbox-row">
                <input class="form-check-input" asp-for="Input.RememberMe" />
                <label asp-for="Input.RememberMe" class="mb-0">@Html.DisplayNameFor(m => m.Input.RememberMe)</label>
            </div>
            <button id="login-submit" type="submit" class="btn-pill btn-pill-primary login-submit-btn">Log in</button>

            <div class="login-links">
                <a id="forgot-password" asp-page="./ForgotPassword">Forgot your password?</a>
                <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Register as a new user</a>
                <a id="resend-confirmation" asp-page="./ResendEmailConfirmation">Resend email confirmation</a>
            </div>
        </form>
    </div>

    <div class="login-copy">
        <h1 class="page-title login-copy-title">Track every transaction, in one place.</h1>
        <p class="login-copy-subtitle">Bank sync, a spending calendar, and AI categorization - all in one dashboard.</p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
